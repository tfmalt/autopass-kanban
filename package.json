{
  "name": "kanban-workspace",
  "version": "26.6.1902",
  "private": true,
  "packageManager": "npm@11.9.0",
  "scripts": {
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:test": "npm --prefix web run test",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:build": "npm --prefix web run build",
    "web:generate-types": "cargo test -p kanban-web-server export_bindings -- --exact",
    "web:check-generated": "cargo test -p kanban-web-server generated_bindings_are_current -- --exact",
    "docker:up": "./docker-compose.up.sh",
    "docker:shell": "./docker-compose.bash.sh"
  }
}
